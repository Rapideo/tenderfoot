{
  "name": "tenderfoot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=20.12" },
  "workspaces": ["app/client", "app/server", "app/shared"],
  "scripts": {
    "dev": "npm run dev --workspace app/server & npm run dev --workspace app/client",
    "migrate:deploy": "tsx app/server/src/db/migrate.ts",
    "build": "npm run migrate:deploy && npm run build --workspace app/client",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "tokens": "python prototype/tools/verify-tokens.py && python prototype/tools/verify-type.py",
    "check": "node --env-file-if-exists=.env scripts/check.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
