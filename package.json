{
  "name": "tenderfoot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "workspaces": [
    "app/client",
    "app/server",
    "app/shared"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "migrate:deploy": "tsx app/server/src/db/migrate.ts",
    "migrate:production": "node --env-file-if-exists=.env scripts/migrate-production.mjs",
    "build": "npm run migrate:deploy && npm run build --workspace app/client",
    "typecheck": "tsc --build --force && tsc -p tsconfig.api.json",
    "test": "vitest run",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "tokens": "python prototype/tools/verify-tokens.py && python prototype/tools/verify-type.py && node scripts/sync-tokens.mjs --check",
    "check": "node --env-file-if-exists=.env scripts/check.mjs",
    "test:clean": "node --env-file-if-exists=.env --import tsx scripts/clean-test-schemas.mjs",
    "scrape": "tsx --env-file-if-exists=.env app/server/src/scrape/cli.ts",
    "import": "tsx --env-file-if-exists=.env app/server/src/ingest/import-cli.ts",
    "merge": "tsx --env-file-if-exists=.env app/server/src/merge/merge-cli.ts",
    "fitness": "tsx --env-file-if-exists=.env app/server/src/fitness/fitness-cli.ts",
    "contracts:ingest": "tsx --env-file-if-exists=.env app/server/src/contracts/contracts-cli.ts"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
